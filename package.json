{
  "name": "paris-transit-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors blue,green \"npm run dev -w @paris-transit/server\" \"npm run dev -w @paris-transit/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:validate": "npm run validate -w @paris-transit/network-build",
    "data:import": "npm run import -w @paris-transit/network-build --",
    "test:e2e": "npm run build -w @paris-transit/web && npm run test:e2e -w @paris-transit/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run data:validate && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "concurrently": "9.2.4",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "none"
  }
}
