NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# fixture (offline simulator, the default) or prim (live data; needs the two PRIM settings below).
TRANSIT_SOURCE=fixture

PRIM_API_KEY=
PRIM_ID_MAP_PATH=
PRIM_API_BASE_URL=https://prim.iledefrance-mobilites.fr/marketplace
PRIM_REQUEST_TIMEOUT_MS=30000
PRIM_MAX_COMPRESSED_RESPONSE_BYTES=33554432
PRIM_MAX_DECODED_RESPONSE_BYTES=134217728

# Empty uses data/paris-metro.
NETWORK_MANIFEST_PATH=
SEGMENT_TIMES_PATH=
API_RATE_LIMIT_PER_MINUTE=240
